# ── Dependencies ──────────────────────────────────────────
node_modules/
**/node_modules/

# ── Build outputs ─────────────────────────────────────────
client/dist/
mobile/.expo/
mobile/dist/

# ── Database & runtime data ───────────────────────────────
server/localchat.db
server/localchat.db-shm
server/localchat.db-wal
*.db
*.db-shm
*.db-wal

