server/cert.pem
server/key.pem
server/cert.meta.json
*.pem
*.crt
*.key
*.p12
*.pfx

# ── Secrets & environment variables ──────────────────────
.env
.env.*
!.env.example
*.secret
secrets/
jwt_secret*

# ── Uploads (user content — never commit) ────────────────
server/uploads/

# ── Mobile app sensitive / generated ─────────────────────
mobile/google-services.json
mobile/GoogleService-Info.plist
mobile/android/app/google-services.json
mobile/ios/GoogleService-Info.plist
mobile/eas.json
*.keystore
*.jks
mobile/android/app/*.keystore

# ── OS & editor ───────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini
.cursor/
.vscode/settings.json
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

