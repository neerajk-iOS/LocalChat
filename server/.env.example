# Copy this file to .env and fill in your values
# Never commit .env to git

# ── Required ──────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars

# ── Optional ──────────────────────────────────────────────
# Restrict CORS to your domain (leave unset to allow all — dev only)
# ALLOWED_ORIGINS=https://chat.example.com,https://app.example.com

# Custom ports (defaults shown)
# PORT=3700
# HTTPS_PORT=3743

# Path to store TLS certs (defaults to server/ directory)
# CERT_DIR=/var/data/certs

# Provide real TLS cert from Let's Encrypt / Caddy (optional)
# TLS_CERT=/etc/letsencrypt/live/example.com/fullchain.pem
# TLS_KEY=/etc/letsencrypt/live/example.com/privkey.pem
